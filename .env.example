# Copy this file to .env and replace every placeholder before starting the stack.
#
#   cp .env.example .env
#
# .env is git-ignored and must stay that way. Never commit real values, and
# never echo them from a script — the stack is started in front of an audience.

# ---------------------------------------------------------------------------
# PostgreSQL
# One instance hosts three databases: source_db (simulated upstream system),
# warehouse_db (pipeline output), and airflow (orchestrator metadata).
# See adr/0001-separate-databases-for-source-warehouse-and-orchestrator.md
# ---------------------------------------------------------------------------
POSTGRES_USER=adc
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=adc
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Source dataset
# Generated with a fixed random seed so every cold start produces identical
# data. Changing either value changes what the demo shows, and SEED_ROW_COUNT
# is asserted by ./verify-stack.sh.
# See adr/0005-generate-seed-data-deterministically-from-a-one-shot-service.md
# ---------------------------------------------------------------------------
SEED_ROW_COUNT=25000
SEED_RANDOM_SEED=61

# The simulated upstream system keeps operating: new records arrive on this
# interval, generated from the same seed so the source stays reproducible.
# ./verify-stack.sh accepts a source count of SEED_ROW_COUNT plus a whole number
# of these batches, and rejects anything else.
ARRIVAL_BATCH_SIZE=25
ARRIVAL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Airflow
# LocalExecutor, metadata in the shared instance, no broker, no workers.
# See adr/0004-run-the-orchestrator-on-localexecutor-with-shared-metadata-storage.md
#
# AIRFLOW_UID must match the host user on Linux so bind-mounted directories
# stay writable. On macOS Docker Desktop the default is fine. Find yours with:
#   id -u
# AIRFLOW__API_AUTH__JWT_SECRET signs the API tokens the agent will use from
# CH6 onward, and must be identical across the api-server and scheduler.
# ---------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=replace-me
AIRFLOW__API_AUTH__JWT_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Observability
# Phoenix keeps its own storage on a named volume, deliberately independent of
# the PostgreSQL instance above.
# See adr/0006-keep-observability-storage-independent-of-pipeline-storage.md
# ---------------------------------------------------------------------------
PHOENIX_PORT=6006
PHOENIX_OTLP_PORT=4317

# ---------------------------------------------------------------------------
# Agent reasoning
#
# The agent talks to any OpenAI-COMPATIBLE endpoint. The OPENAI_ prefix names
# the protocol, not the supplier — it is kept because that is what
# OpenAI-compatible clients read by convention.
# See adr/0018-depend-on-an-openai-compatible-endpoint-not-a-vendor.md
#
# Switching provider is an edit here, not a code change. Examples:
#   OpenAI      https://api.openai.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter  https://openrouter.ai/api/v1
#
# The agent checks this configuration once at startup and reports the result
# through ./verify-stack.sh, so a wrong model id or an unreachable endpoint
# shows up at `docker compose up` rather than in the middle of an incident.
# Structured responses are required — verify a new provider supports them.
# ---------------------------------------------------------------------------
# Measured rather than assumed. The same drift scenario was run against three
# candidates; all three diagnosed it correctly and all three produced a fix that
# built on the first attempt. What separated them was speed and price:
#
#   google/gemini-2.5-flash-lite   11s   $0.0003 per incident
#   google/gemini-2.5-flash        10s   $0.0015 per incident
#   google/gemini-3.7-flash        41s   $0.0036 per incident
#
# flash-lite is pinned: as correct as the others here, four times faster than
# the most expensive, and a tenth of its price. Note what the numbers also say —
# even the dearest is under half a cent, so a small budget is not what decides
# this. If a rehearsal shows flash-lite struggling on a harder failure, moving up
# a tier costs nothing worth counting.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731

# How often the agent looks for a failed pipeline run.
AGENT_POLL_INTERVAL_SECONDS=20

# ---------------------------------------------------------------------------
# Operator console
#
# The console holds two credentials, both narrower than the agent's, because
# "the interface writes only the decision" is a claim the demo makes out loud
# and should be a limit rather than a habit.
# See adr/0027-bound-the-consoles-authority-by-grant.md
#
# DASHBOARD_DB_* is a PostgreSQL role that may read the incident record and
# update one column of it — the operator's decision — and nothing else. It is
# created by an initialisation script, which runs only on an empty volume, so
# changing it means starting from `docker compose down -v`.
#
# AIRFLOW_VIEWER_* is an orchestrator user with a read-only role. The console
# reads the latest run's status to report pipeline health and must not be able
# to start a run.
# See adr/0026-read-pipeline-health-from-the-run-not-the-data.md
# ---------------------------------------------------------------------------
DASHBOARD_DB_USER=dashboard
DASHBOARD_DB_PASSWORD=replace-me
AIRFLOW_VIEWER_USERNAME=viewer
AIRFLOW_VIEWER_PASSWORD=replace-me

# How often the console re-reads while the system is moving. It stops
# refreshing entirely once a proposal is awaiting a decision.
DASHBOARD_REFRESH_SECONDS=5
DASHBOARD_PORT=8501

# Required: a different model ID from OPENAI_MODEL.
JUDGE_MODEL=openai/gpt-5.6-luna
# Optional; empty values reuse the producer endpoint and key.
JUDGE_BASE_URL=
JUDGE_API_KEY=
